---
// A direct contact surface in a native <dialog>. The address is visible,
// selectable and copyable; the button announces success in a live region.
import { landing } from '../i18n/index.mjs';
import { HELP_EMAIL } from '../config.mjs';

const { locale = 'en' } = Astro.props;
const s = landing(locale);
---

<dialog id="contact-dialog" data-contact-dialog aria-labelledby="contact-title">
  <div class="head">
    <h3 id="contact-title">{s.contact.title}</h3>
    <button type="button" class="close" data-contact-close aria-label={s.a11y.close}>
      <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
  </div>
  <div class="contact-body">
    <p>{s.contact.body}</p>
    <a class="email" href={`mailto:${HELP_EMAIL}`}>{HELP_EMAIL}</a>
    <button class="btn-pill" type="button" data-copy-email={HELP_EMAIL}>{s.contact.copy}</button>
  </div>
</dialog>

<div class="snackbar" data-copy-snackbar role="status" aria-live="polite" hidden>
  {s.contact.copied}
</div>

<style>
  dialog {
    border: none;
    border-radius: 24px;
    padding: 0;
    width: min(440px, calc(100vw - 40px));
    background: var(--lav-0);
    color: var(--ink);
    box-shadow: 0 40px 90px rgba(16, 10, 40, 0.35);
  }

  dialog::backdrop {
    background: rgba(16, 12, 40, 0.45);
    backdrop-filter: blur(4px);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 26px 0;
  }

  h3 {
    font-weight: 700;
    font-size: 20px;
  }

  .close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 6px;
  }

  .contact-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 26px 26px;
  }

  .contact-body p {
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .email {
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid rgba(21, 63, 64, 0.16);
    border-radius: 12px;
    padding: 12px 14px;
    overflow-wrap: anywhere;
  }

  .contact-body .btn-pill {
    justify-content: center;
    margin-top: 4px;
  }

  .snackbar {
    position: fixed;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 400;
    transform: translateX(-50%);
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--night);
    color: white;
    font-size: 14px;
    box-shadow: 0 14px 36px rgba(8, 34, 35, 0.28);
  }
</style>

<script>
  const dialog = document.querySelector('[data-contact-dialog]') as HTMLDialogElement | null;
  if (dialog) {
    for (const opener of document.querySelectorAll('[data-contact-open]')) {
      opener.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
      });
    }
    dialog.querySelector('[data-contact-close]')?.addEventListener('click', () => dialog.close());
    // Close on a true backdrop click only: a text-selection drag that
    // starts in the textarea and releases outside must not destroy a
    // half-typed message, so both pointerdown and click must land on the
    // dialog element itself (code review 2026-07-24).
    let downOnBackdrop = false;
    dialog.addEventListener('pointerdown', (e) => {
      downOnBackdrop = e.target === dialog;
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog && downOnBackdrop) dialog.close();
    });
  }

  const copyButton = document.querySelector('[data-copy-email]') as HTMLButtonElement | null;
  const snackbar = document.querySelector('[data-copy-snackbar]') as HTMLElement | null;
  let snackbarTimer: number | undefined;
  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.copyEmail ?? '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      const input = document.createElement('textarea');
      input.value = email;
      input.style.position = 'fixed';
      input.style.opacity = '0';
      document.body.append(input);
      input.select();
      document.execCommand('copy');
      input.remove();
    }
    if (snackbar) {
      snackbar.hidden = false;
      window.clearTimeout(snackbarTimer);
      snackbarTimer = window.setTimeout(() => { snackbar.hidden = true; }, 2400);
    }
  });
</script>
