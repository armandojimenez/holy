---
// The home-screen widgets device (deck port: widgets.js + the native
// HomeWidget.swift design): Holy's book art washed light, one medium
// widget + two smalls — flat theme color, faint centered dove,
// Playfair text. The second small tilts, exactly like the deck.
import FeatureSection from './FeatureSection.astro';
import Phone from './Phone.astro';
import { deck, landing } from '../i18n/index.mjs';
import { asset } from '../config.mjs';
import sections from '../data/generated/sections.json';

const { locale = 'en' } = Astro.props;
const d = deck(locale);
const s = landing(locale);
const sec = sections[locale];

// WIDGET_THEMES (HomeWidget.swift): default / dark / whitePink
const widgets = [
  { cls: 'medium', bg: '#12585B', text: '#FFFFFF', bird: '#FFFFFF', op: 0.05, quote: sec.widgets.medium },
  { cls: 'small s1', bg: '#242424', text: '#FFFFFF', bird: '#FFFFFF', op: 0.1, quote: sec.widgets.smallDark },
  { cls: 'small s2', bg: '#F4EFE5', text: '#12585B', bird: '#12585B', op: 0.07, quote: sec.widgets.smallPink },
  { cls: 'medium m2', bg: '#287B3E', text: '#FFFFFF', bird: '#FFFFFF', op: 0.08, quote: sec.widgets.medium2 },
];
---

<FeatureSection title={d.widgets.hero} body={s.sections.widgets.body} tone="light">
  <div class="scene" role="img" aria-label={s.sections.widgets.artLabel}>
    <div class="space" aria-hidden="true">
      <div class="phone-scale">
        <Phone frame="light" status="dark">
          <div class="w-screen">
            <img class="wall" src={asset('/app/images/backgrounds/theme_bg/book.webp')} alt="" loading="lazy" width="440" height="956" />
            <div class="wash"></div>
            {widgets.map((w) => (
              <div class={`widget ${w.cls}`} style={`background:${w.bg}`}>
                <span class="w-bird" style={`background:${w.bird};opacity:${w.op}`}></span>
                <span class="w-text" style={`color:${w.text}`}>{w.quote}</span>
              </div>
            ))}
          </div>
        </Phone>
      </div>
    </div>
  </div>
</FeatureSection>

<style>
  .scene {
    --fw: 400;
    width: calc(var(--fw) * 1px);
    height: calc(var(--fw) * 1.62px);
    position: relative;
  }

  .space {
    position: absolute;
    top: 0;
    left: 0;
    width: 504px;
    height: 1068px;
    transform: scale(calc(var(--fw) / 504));
    transform-origin: top left;
  }

  .phone-scale {
    transform: scale(0.46);
    transform-origin: top left;
  }

  /* ── In-screen (440pt logical space): deck geometry pad 24, top 96,
     innerW 392, medium 392x184, smalls 185x185 ── */
  .w-screen {
    position: absolute;
    inset: 0;
  }

  .wall {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wash {
    position: absolute;
    inset: 0;
    background: rgba(255, 251, 248, 0.12);
  }

  .widget {
    position: absolute;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 18px 40px rgba(30, 15, 60, 0.22);
  }

  .medium {
    left: 24px;
    top: 96px;
    width: 392px;
    height: 184px;
  }

  .small {
    width: 185px;
    height: 185px;
  }

  .s1 {
    left: 24px;
    top: 302px;
  }

  .s2 {
    left: 231px;
    top: 318px;
    transform: rotate(4deg);
    box-shadow: 0 18px 40px rgba(30, 15, 60, 0.26);
  }

  /* The second medium widget below the small row (deck parity) */
  .m2 {
    top: 529px;
    height: 169px;
    transform: rotate(-1.5deg);
    box-shadow: 0 18px 40px rgba(30, 15, 60, 0.24);
  }

  .m2 .w-text {
    font-size: 20px;
  }

  /* The faint centered dove (mask tint, HomeWidget.swift parity) */
  .w-bird {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 148px;
    height: 148px;
    -webkit-mask: url('/holy/app/images/svgIcons/paloma.svg') no-repeat center / contain;
    mask: url('/holy/app/images/svgIcons/paloma.svg') no-repeat center / contain;
  }

  .medium .w-bird {
    width: 147px;
    height: 147px;
  }

  .w-text {
    position: relative;
    padding: 0 18px;
    text-align: center;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.3;
    text-wrap: balance;
  }

  .medium .w-text {
    font-size: 21px;
    padding: 0 35px;
  }

  @media (max-width: 1120px) {
    .scene { --fw: 350; }
  }
  @media (max-width: 470px) {
    .scene { --fw: 300; }
  }
  @media (max-width: 340px) {
    .scene { --fw: 280; }
  }
</style>
