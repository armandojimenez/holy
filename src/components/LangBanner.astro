---
// First-visit language suggestion: a slim dismissible bar that appears
// only when navigator.language matches a different available locale.
// Copy is written in the VISITOR'S language (that is who it is for).
// Never auto-redirects; choice is remembered in localStorage.
import { LANG_BANNERS, PUBLISHED_LOCALES, localeUrl } from '../i18n/index.mjs';
import { BASE } from '../config.mjs';

const { locale = 'en' } = Astro.props;
const data = {
  page: locale,
  locales: PUBLISHED_LOCALES,
  banners: Object.fromEntries(PUBLISHED_LOCALES.map((l) => [l, LANG_BANNERS[l]])),
  urls: Object.fromEntries(PUBLISHED_LOCALES.map((l) => [l, localeUrl(l)])),
};
---

<div class="lang-banner" data-lang-banner data-cfg={JSON.stringify(data)} hidden>
  <p><span data-banner-text></span></p>
  <div class="actions">
    <a class="go" data-banner-go href={`${BASE}/`}></a>
    <button class="dismiss" type="button" data-banner-dismiss></button>
  </div>
</div>

<style>
  /* Fixed toast: revealing it never reflows the page (zero CLS). */
  .lang-banner {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 150;
    width: fit-content;
    max-width: calc(100vw - 32px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    background: var(--ink);
    color: var(--lav-0);
    padding: 12px 22px;
    font-size: 14px;
    border-radius: 16px;
    box-shadow: 0 18px 44px rgba(16, 10, 40, 0.28);
  }

  .lang-banner[hidden] {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .go {
    color: var(--lav-0);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dismiss {
    background: none;
    border: 1px solid rgba(245, 244, 254, 0.35);
    border-radius: 999px;
    color: rgba(245, 244, 254, 0.85);
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 4px 12px;
    cursor: pointer;
  }

  .dismiss:hover {
    border-color: rgba(245, 244, 254, 0.7);
    color: var(--lav-0);
  }
</style>

<script>
  const el = document.querySelector('[data-lang-banner]') as HTMLElement | null;
  if (el) {
    const KEY = 'mtv-lang-banner-dismissed';
    const cfg = JSON.parse(el.dataset.cfg!);
    try {
      if (!localStorage.getItem(KEY)) {
        const nav = (navigator.languages?.[0] ?? navigator.language ?? '').toLowerCase();
        const base = nav.split('-')[0];
        // pt-BR and pt-PT both map onto the pt page, same rule as the app
        const target = cfg.locales.includes(base) ? base : null;
        if (target && target !== cfg.page) {
          const b = cfg.banners[target];
          el.querySelector('[data-banner-text]')!.textContent = b.text;
          const go = el.querySelector('[data-banner-go]') as HTMLAnchorElement;
          go.textContent = b.cta;
          go.href = cfg.urls[target];
          go.lang = target;
          const dis = el.querySelector('[data-banner-dismiss]') as HTMLButtonElement;
          dis.textContent = b.dismiss;
          dis.addEventListener('click', () => {
            localStorage.setItem(KEY, '1');
            el.hidden = true;
          });
          el.hidden = false;
        }
      }
    } catch {
      /* storage blocked: stay hidden, never nag every visit */
    }
  }
</script>
