---
// FAQ: native details/summary accordion (keyboard + screen-reader friendly,
// zero JS). Feeds the FAQPage schema.
import { landing } from '../i18n/index.mjs';

const { locale = 'en' } = Astro.props;
const s = landing(locale);
---

<section id="faq" class="faq">
  <div class="container inner">
    <h2>
      <span class="dove" aria-hidden="true"></span>
      {s.faq.title}
    </h2>
    <div class="items">
      {s.faq.items.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: linear-gradient(180deg, var(--lav-1) 0%, var(--lav-0) 100%);
    padding: clamp(64px, 9vh, 110px) 0;
  }

  .inner {
    max-width: 760px;
  }

  h2 {
    font-weight: 700;
    font-size: clamp(30px, 3.2vw, 46px);
    letter-spacing: -0.015em;
    color: var(--ink);
    text-align: center;
  }

  .dove {
    display: block;
    width: 26px;
    height: 26px;
    margin: 0 auto 14px;
    background: var(--bird);
    transform: rotate(-8deg);
    -webkit-mask: url('/holy/app/images/svgIcons/paloma.svg') no-repeat center / contain;
    mask: url('/holy/app/images/svgIcons/paloma.svg') no-repeat center / contain;
  }

  .items {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  details {
    background: var(--paper);
    border-left: 3px solid transparent;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 2px 14px rgba(21, 63, 64, 0.07);
    transition: border-color 0.25s ease;
  }

  details[open] {
    border-left-color: var(--bird);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 18px 22px;
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    flex: 0 0 auto;
    color: var(--bird);
    transition: transform 0.25s ease;
  }

  details[open] summary svg {
    transform: rotate(45deg);
  }

  details p {
    padding: 0 22px 20px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
  }
</style>
