---
// Closing call to action: the night-indigo band (deck proof-slide sky),
// the dove, big line, official store badges.
import { landing } from '../i18n/index.mjs';
import { storeUrls, asset } from '../config.mjs';

const { locale = 'en' } = Astro.props;
const s = landing(locale);
const stores = storeUrls(locale);
---

<section id="download" class="cta">
  <div class="container inner">
    <img class="bird" src={asset('/app/images/svgIcons/paloma.svg')} alt="" width="64" height="64" aria-hidden="true" />
    <h2>{s.cta.title}</h2>
    <p>{s.cta.body}</p>
    <div class="badges">
      <a href={stores.ios}>
        <img src={asset('/img/badges/app-store-badge.svg')} alt={s.hero.badgeIos} width="189" height="56" />
      </a>
      <a href={stores.android}>
        <img src={asset('/img/badges/google-play-badge.svg')} alt={s.hero.badgeAndroid} width="189" height="56" />
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(180deg, var(--night-2) 0%, var(--night) 100%);
    padding: clamp(72px, 10vh, 120px) 0;
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .bird {
    width: 56px;
    height: auto;
    transform: rotate(-8deg);
    margin-bottom: 18px;
    filter: brightness(1.5);
  }

  h2 {
    font-weight: 700;
    font-size: clamp(34px, 4.4vw, 64px);
    letter-spacing: -0.015em;
    color: #f2effb;
  }

  p {
    margin-top: 14px;
    font-size: clamp(15px, 1.5vw, 18px);
    color: rgba(242, 239, 251, 0.7);
  }

  .badges {
    margin-top: 36px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .badges img {
    height: 56px;
    width: auto;
  }
</style>
