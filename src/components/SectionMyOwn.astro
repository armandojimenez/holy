---
// The personal collection device (deck port: myown.js), alive: the private
// list of the user's own words + borrowed lines, with the add-quote dialog
// popped over it — and the dialog TYPES the new quote, live, in the
// visitor's language.
import FeatureSection from './FeatureSection.astro';
import Phone from './Phone.astro';
import { deck, landing } from '../i18n/index.mjs';
import sections from '../data/generated/sections.json';

const { locale = 'en' } = Astro.props;
const d = deck(locale);
const s = landing(locale);
const sec = sections[locale];
const rows = d.myown.rows;
---

<FeatureSection title={d.myown.hero} body={s.sections.myown.body} flip tone="tint">
  <div class="scene" role="img" aria-label={s.sections.myown.artLabel}>
    <div class="space" aria-hidden="true">
      <div class="phone-scale">
        <Phone frame="light" status="dark">
          <div class="mo-screen">
            <div class="mo-bar">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5 8 12l6.5 7"/></svg>
              <span class="mo-title">{sec.myown.title}</span>
              <span class="mo-add">+ {sec.myown.add}</span>
            </div>
            <div class="mo-rows">
              {rows.map((r) => (
                <div class="mo-row">
                  <p class="mo-text">{r.text}</p>
                  <div class="mo-meta">
                    {r.author && <span class="mo-author">- {r.author}</span>}
                    <span class="mo-date">{r.date}</span>
                  </div>
                </div>
              ))}
            </div>
            <div class="dim"></div>
            <div class="dialog" data-myown-dialog data-text={d.myown.dialogTyped}>
              <div class="dlg-title">{sec.myown.dialogTitle}</div>
              <div class="dlg-input">
                <span data-typed>{d.myown.dialogTyped}</span><span class="caret" aria-hidden="true"></span>
              </div>
              <div class="dlg-author">- {d.myown.dialogAuthor}</div>
              <div class="dlg-save">{sec.myown.save}</div>
            </div>
          </div>
        </Phone>
      </div>
    </div>
  </div>
</FeatureSection>

<style>
  .scene {
    --fw: 400;
    width: calc(var(--fw) * 1px);
    height: calc(var(--fw) * 1.62px);
    position: relative;
  }

  .space {
    position: absolute;
    top: 0;
    left: 0;
    width: 504px;
    height: 1068px;
    transform: scale(calc(var(--fw) / 504));
    transform-origin: top left;
  }

  .phone-scale {
    transform: scale(0.46);
    transform-origin: top left;
  }

  /* ── In-screen (440pt logical space) ── */
  .mo-screen {
    position: absolute;
    inset: 0;
    background: #ffffff;
  }

  .mo-bar {
    position: absolute;
    top: 58px;
    left: 14px;
    right: 14px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mo-title {
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
    font-weight: 600;
    font-size: 20px;
    color: #1a1a1a;
  }

  .mo-add {
    position: relative;
    z-index: 2;
    padding: 7px 14px;
    border-radius: 999px;
    background: linear-gradient(90deg, #12585b 0%, #31999d 100%);
    color: #fff;
    font-weight: 600;
    font-size: 13px;
    white-space: nowrap;
  }

  .mo-rows {
    position: absolute;
    top: 122px;
    left: 0;
    right: 0;
  }

  .mo-row {
    padding: 20px 24px;
  }

  .mo-row:nth-child(odd) {
    background: #f6f4fc;
  }

  .mo-text {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.4;
    color: #23214a;
  }

  .mo-meta {
    margin-top: 6px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 13px;
    color: rgba(35, 33, 74, 0.5);
  }

  .mo-author {
    font-weight: 600;
  }

  .mo-date {
    margin-left: auto;
  }

  .dim {
    position: absolute;
    inset: 0;
    background: rgba(16, 10, 40, 0.42);
    z-index: 8;
  }

  /* The add dialog, popped and slightly rotated (deck parity) */
  .dialog {
    position: absolute;
    top: 250px;
    left: 26px;
    right: 26px;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 34px 80px rgba(15, 8, 35, 0.5);
    padding: 24px 24px 22px;
    transform: rotate(-3deg);
    z-index: 9;
  }

  .dlg-title {
    font-weight: 600;
    font-size: 18px;
    color: #1c1a38;
  }

  .dlg-input {
    margin-top: 16px;
    min-height: 88px;
    border-radius: 12px;
    background: #f4f2fa;
    padding: 14px 16px;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.45;
    color: #23214a;
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: #31999d;
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .dlg-author {
    margin-top: 12px;
    font-size: 14px;
    color: rgba(35, 33, 74, 0.55);
  }

  .dlg-save {
    margin-top: 18px;
    height: 46px;
    border-radius: 12px;
    background: linear-gradient(180deg, #31999d 0%, #12585b 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 16px;
    color: #fff;
    box-shadow: 0 8px 22px rgba(49, 153, 157, 0.28);
  }

  @media (max-width: 1120px) {
    .scene { --fw: 350; }
  }
  @media (max-width: 470px) {
    .scene { --fw: 300; }
  }
  @media (max-width: 340px) {
    .scene { --fw: 280; }
  }
</style>

<script>
  // The dialog types its line, rests, and starts over.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const dlg of document.querySelectorAll<HTMLElement>('[data-myown-dialog]')) {
    const target = dlg.querySelector('[data-typed]')!;
    const full = dlg.dataset.text ?? '';
    if (reduced || !full) continue; // reduced motion keeps the full line
    let pos = full.length; // server-rendered full; restart on first tick
    let timer: ReturnType<typeof setInterval> | null = null;

    const tick = () => {
      if (document.hidden) return;
      pos += 1;
      if (pos > full.length + 30) pos = 0; // ~2s rest at the full line
      target.textContent = full.slice(0, Math.min(pos, full.length));
    };

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !timer) timer = setInterval(tick, 70);
        else if (!entry.isIntersecting && timer) {
          clearInterval(timer);
          timer = null;
        }
      },
      { threshold: 0.3 }
    );
    io.observe(dlg);
  }
</script>
