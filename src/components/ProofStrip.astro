---
// Honest social proof under the hero: per-store ratings + the family
// downloads claim (same numbers as the deck's proof slide, July 2026 —
// iOS displays 5.0, Play 4.8, 1M+ across the family).
import { landing } from '../i18n/index.mjs';
import { RATING } from '../config.mjs';

const { locale = 'en' } = Astro.props;
const s = landing(locale);

const stars = [1, 2, 3, 4, 5];
---

<section class="proof" aria-label={s.a11y.ratings}>
  <div class="container row">
    <div class="item">
      <div class="stars" aria-hidden="true">
        {stars.map(() => (
          <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 2.5 14.6 8l6 .7-4.5 4 1.3 5.9L12 15.7 6.6 18.6 7.9 12.7l-4.5-4 6-.7z"></path></svg>
        ))}
      </div>
      <div class="num">{RATING.ios}</div>
      <div class="label">{s.proof.ratingIos}</div>
    </div>
    <div class="dot" aria-hidden="true"></div>
    <div class="item">
      <div class="num">{RATING.android}</div>
      <div class="label">{s.proof.ratingAndroid}</div>
    </div>
    <div class="dot" aria-hidden="true"></div>
    <div class="item">
      <div class="num">{s.proof.downloadsValue}</div>
      <div class="label">{s.proof.downloads}</div>
    </div>
  </div>
</section>

<style>
  .proof {
    background: var(--lav-1);
    border-top: 1px solid rgba(21, 63, 64, 0.07);
    border-bottom: 1px solid rgba(21, 63, 64, 0.07);
    padding: 26px 0;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 4vw, 48px);
    flex-wrap: wrap;
  }

  .item {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2px 10px;
    min-width: 0;
  }

  .stars {
    display: flex;
    gap: 2px;
    align-self: center;
  }

  .stars svg {
    fill: var(--bird);
  }

  .num {
    font-weight: 700;
    font-size: 22px;
    color: var(--ink);
  }

  .label {
    font-size: 14px;
    color: var(--ink-soft);
    min-width: 0;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(21, 63, 64, 0.25);
  }

  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      gap: 12px;
    }
    .item {
      width: 100%;
    }
    .dot {
      display: none;
    }
  }
</style>
